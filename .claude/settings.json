{
  "permissions": {
    "allow": [
      "Bash(git push origin --delete *)",
      "Bash(git branch -d *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune)",
      "Bash(orca worktree rm *)",
      "Bash(orca terminal close *)"
    ]
  },
  "extraKnownMarketplaces": {
    "auto-pipeline": {
      "source": {
        "source": "github",
        "repo": "maverick1014/auto-pipeline"
      }
    }
  },
  "enabledPlugins": {
    "auto-pipeline@auto-pipeline": true
  }
}
