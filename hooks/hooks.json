{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/agent-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${AGENT_CITY_DIR:-$HOME/.cache/agent-city}/on\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/agent-city-hook.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${AGENT_CITY_DIR:-$HOME/.cache/agent-city}/on\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/agent-city-hook.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${AGENT_CITY_DIR:-$HOME/.cache/agent-city}/on\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/agent-city-hook.sh\"; exit 0",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${AGENT_CITY_DIR:-$HOME/.cache/agent-city}/on\" ] && python3 \"${CLAUDE_PLUGIN_ROOT}/bin/agent_city.py\" ask; exit 0",
            "timeout": 3660
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${AGENT_CITY_DIR:-$HOME/.cache/agent-city}/on\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/agent-city-hook.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${AGENT_CITY_DIR:-$HOME/.cache/agent-city}/on\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/agent-city-hook.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${AGENT_CITY_DIR:-$HOME/.cache/agent-city}/on\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/agent-city-hook.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${AGENT_CITY_DIR:-$HOME/.cache/agent-city}/on\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/agent-city-hook.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${AGENT_CITY_DIR:-$HOME/.cache/agent-city}/on\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/agent-city-hook.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${AGENT_CITY_DIR:-$HOME/.cache/agent-city}/on\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/agent-city-hook.sh\"; exit 0",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${AGENT_ROLE:-}\" ] && [ -f \"${AGENT_CITY_DIR:-$HOME/.cache/agent-city}/on\" ] && exec python3 \"${CLAUDE_PLUGIN_ROOT}/bin/agent_city.py\" gov-watch; exit 0",
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${AGENT_CITY_DIR:-$HOME/.cache/agent-city}/on\" ] && \"${CLAUDE_PLUGIN_ROOT}/bin/agent-city-hook.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
