    {
      "blocks": [
        { "type": "band", "color": "crimson", "title": "一、启示的传递", "ref": "启示录 1:1-3" },
        { "type": "row", "cells": [
          { "panel": "p01", "num": "1", "name": "从神而来",
            "verse": "耶稣基督的启示,就是神赐给他,叫他将必要快成的事指示他的众仆人。",
            "ref": "启 1:1" },
          { "panel": "p02", "num": "2", "name": "约翰作见证",
            "verse": "约翰便将神的道和耶稣基督的见证,凡自己所看见的都证明出来。",
            "ref": "启 1:2" } ] },
        { "type": "band", "color": "navy", "title": "二、拔摩海岛", "ref": "启示录 1:9" },
        { "type": "row", "cells": [
          { "panel": "p03", "num": "3", "name": "流放之地",
            "verse": "我约翰就是你们的弟兄,和你们在耶稣的患难、国度、忍耐里一同有分,为神的道,并为给耶稣作的见证,曾在那名叫拔摩的海岛上。",
            "ref": "启 1:9" },
          { "panel": "p04", "num": "4", "name": "荒凉与风浪",
            "note": "拔摩是爱琴海上的流放小岛,多岩少水。约翰在此已届晚年。",
            "layer": "INFERRED" } ] },
        { "type": "row", "cells": [
          { "panel": "p05", "num": "5", "name": "患难中的忍耐",
            "note": "他没有说「我为你们受苦」,而说「与你们一同有分」——受苦的教会有一位同伴。" },
          { "panel": "p06", "num": "6", "name": "年老的见证人",
            "note": "同一位约翰,年少时靠在主的胸膛,年老时被流放海岛。" } ] }
      ]
    },

    {
      "blocks": [
        { "type": "band", "color": "purple", "title": "三、主日的声音", "ref": "启示录 1:10-11" },
        { "type": "row", "cells": [
          { "panel": "p07", "num": "7", "name": "被圣灵感动",
            "verse": "当主日,我被圣灵感动,听见在我后面有大声音如吹号。",
            "ref": "启 1:10" },
          { "panel": "p08", "num": "8", "name": "声音在身后",
            "note": "声音来自身后——他必须转身,才能看见。异象不是他寻找来的,是临到他的。" } ] },
        { "type": "row", "cells": [
          { "panel": "p09", "num": "9", "name": "写给七个教会",
            "verse": "你所看见的当写在书上,达与以弗所、士每拿、别迦摩、推雅推喇、撒狄、非拉铁非、老底嘉、那七个教会。",
            "ref": "启 1:11" } ] },
        { "type": "band", "color": "gold", "title": "四、七个金灯台", "ref": "启示录 1:12" },
        { "type": "row", "cells": [
          { "panel": "p10", "num": "10", "name": "转过身来所见",
            "verse": "我转过身来,要看是谁发声与我说话;既转过来,就看见七个金灯台。",
            "ref": "启 1:12" } ] }
      ]
    },

    {
      "blocks": [
        { "type": "band", "color": "crimson", "title": "五、人子的显现", "ref": "启示录 1:13-16" },
        { "type": "row", "cells": [
          { "panel": "p11", "num": "11", "name": "灯台中间的一位",
            "verse": "灯台中间有一位好像人子,身穿长衣,直垂到脚,胸间束着金带。",
            "ref": "启 1:13" },
          { "panel": "p12", "num": "12", "name": "眼目如同火焰",
            "verse": "他的头与发皆白,如白羊毛,如雪;眼目如同火焰。",
            "ref": "启 1:14" } ] },
        { "type": "row", "cells": [
          { "panel": "p13", "num": "13", "name": "面貌如同烈日放光",
            "verse": "脚好像在炉中锻炼光明的铜;声音如同众水的声音。他右手拿着七星,从他口中出来一把两刃的利剑;面貌如同烈日放光。",
            "ref": "启 1:15-16" } ] },
        { "type": "table", "title": "人子的九项形象（启 1:13-16）",
          "cols": 3,
          "items": [
            { "name": "长衣垂脚", "note": "祭司的服饰" },
            { "name": "金带束胸", "note": "君王的尊荣" },
            { "name": "头发皆白如雪", "note": "亘古常在" },
            { "name": "眼目如同火焰", "note": "鉴察一切" },
            { "name": "脚如炼铜", "note": "审判的坚立" },
            { "name": "声如众水", "note": "无可抗拒" },
            { "name": "右手拿七星", "note": "掌管教会的使者" },
            { "name": "口出两刃利剑", "note": "话语带着权柄" },
            { "name": "面如烈日", "note": "荣耀不可直视" }
          ] }
      ]
    },

    {
      "blocks": [
        { "type": "band", "color": "navy", "title": "六、不要惧怕", "ref": "启示录 1:17-20" },
        { "type": "row", "cells": [
          { "panel": "p14", "num": "14", "name": "仆倒如死",
            "verse": "我一看见,就仆倒在他脚前,像死了一样。",
            "ref": "启 1:17" },
          { "panel": "p15", "num": "15", "name": "他用右手按着我",
            "verse": "他用右手按着我,说:「不要惧怕!我是首先的,我是末后的,又是那存活的;我曾死过,现在又活了,直活到永永远远;并且拿着死亡和阴间的钥匙。」",
            "ref": "启 1:17-18" } ] },
        { "type": "row", "cells": [
          { "panel": "p16", "num": "16", "name": "奥秘的解开",
            "verse": "那七星就是七个教会的使者,七灯台就是七个教会。",
            "ref": "启 1:20" } ] },
        { "type": "truths", "title": "核心真理",
          "items": [
            { "name": "启示不是猜测", "note": "它有确定的来源与传递链——从神,藉基督,由使者交给约翰。" },
            { "name": "受苦的人不孤单", "note": "写信的人自己就在患难里,他与收信的教会「一同有分」。" },
            { "name": "教会在他手中", "note": "七星在他右手,七灯台围绕着他——教会不在自己手里。" },
            { "name": "死亡不是终局", "note": "「我曾死过,现在又活了」——钥匙在他手上,不在死亡手上。" }
          ] },
        { "type": "quote",
          "text": "不要惧怕!我是首先的,我是末后的,\n又是那存活的;我曾死过,现在又活了,\n直活到永永远远。",
          "ref": "启示录 1:17-18" },
        { "type": "footer",
          "text": "结语：他站在灯台中间——不在远处,不在事外。" }
      ]
    }
  ]
}
